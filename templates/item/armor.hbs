
<div class="metro2033-sheet metro-armor-item-sheet">
  <header class="metro-aptitude-header">
    <p class="metro-subtitle">MÉTRO 2033 · PROTECTIONS</p>
    <h2>Fiche de protection</h2>
  </header>

  <div class="metro-item-illustration">
    <img
      src="{{item.img}}"
      data-edit="img"
      alt="Illustration de {{item.name}}"
      title="Cliquer pour modifier l'image"
    >
  </div>

  <label class="metro-field">
    <span>Nom de la protection</span>
    <input
      type="text"
      name="name"
      value="{{item.name}}"
      placeholder="Nom de la protection"
    >
  </label>

  <div class="metro-armor-properties">
    <label class="metro-field">
      <span>Type</span>
      <select name="system.slot">
        <option value="armure" {{#if isBodyArmor}}selected{{/if}}>
          Armure corporelle
        </option>
        <option value="casque" {{#if isHelmet}}selected{{/if}}>
          Casque
        </option>
      </select>
    </label>

    <label class="metro-field">
      <span>Valeur de protection</span>
      <input
        type="number"
        name="system.protection"
        value="{{system.protection}}"
        min="0"
        step="1"
      >
    </label>

    <label class="metro-field">
      <span>Encombrement (emplacements)</span>
      <input
        type="number"
        name="system.encumbrance"
        value="{{system.encumbrance}}"
        min="0"
        step="0.25"
      >
    </label>

    <label class="metro-armor-resilience">
      <input
        type="checkbox"
        name="system.resilience"
        {{#if system.resilience}}checked{{/if}}
      >
      <span>Résilience (annule 1 dégât tant que la protection est supérieure à 0)</span>
    </label>
  </div>

  <label class="metro-field metro-item-description">
    <span>Description</span>
    <textarea
      name="system.description"
      placeholder="Matériaux, particularités, état, restrictions..."
    >{{system.description}}</textarea>
  </label>

  <div class="metro-item-actions">
    <button type="button" data-action="publish-armor">
      Afficher la protection dans le chat
    </button>
  </div>

  <div class="metro-item-actions">
    <button type="button" data-action="roll-protection">
      Lancer un jet de protection
    </button>
  </div>
</div>
