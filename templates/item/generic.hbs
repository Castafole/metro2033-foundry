
<div class="metro2033-sheet metro-generic-item-sheet">
  <header class="metro-aptitude-header">
    <p class="metro-subtitle">MÉTRO 2033 · ÉQUIPEMENT</p>
    <h2>Objet général</h2>
  </header>

  <div class="metro-item-illustration">
    <img
      src="{{item.img}}"
      data-edit="img"
      alt="Illustration de {{item.name}}"
      title="Cliquer pour modifier l'image"
    >
  </div>

  <label class="metro-field">
    <span>Nom de l'objet</span>
    <input
      type="text"
      name="name"
      value="{{item.name}}"
      placeholder="Nom de l'objet"
    >
  </label>

  <div class="metro-item-properties">
    <label class="metro-field">
      <span>Quantité</span>
      <input
        type="number"
        name="system.quantity"
        value="{{system.quantity}}"
        min="1"
        step="1"
      >
    </label>

    <label class="metro-field">
      <span>Encombrement (emplacements par objet)</span>
      <input
        type="number"
        name="system.encumbrance"
        value="{{system.encumbrance}}"
        min="0"
        step="0.25"
      >
    </label>
  </div>

  <label class="metro-field metro-item-description">
    <span>Description</span>
    <textarea
      name="system.description"
      placeholder="Description, état, provenance ou propriétés particulières..."
    >{{system.description}}</textarea>
  </label>

  <div class="metro-item-actions">
    <button type="button" data-action="publish-generic-item">
      Afficher l'objet dans le chat
    </button>
  </div>
</div>
